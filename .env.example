# Copia este archivo como .env.local (desarrollo) o agrega estas variables en Vercel → Settings → Environment Variables.
# TODAS son opcionales: sin claves de IA, cada persona puede pegar la suya en ⚙️ Ajustes dentro de la app.

# ── Inteligencia artificial (gratis, sin tarjeta) ─────────────────────────────
# Google Gemini (mejor para leer fotos): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq (mejor para el chat, muy rápido): https://console.groq.com/keys
GROQ_API_KEY=

# ── Base de datos para avisos con la app cerrada y calendario que se actualiza solo ──
# Vercel → Storage → Upstash for Redis (plan gratis) crea estas variables automáticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (También sirven UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN si creas la base en upstash.com)

# ── Notificaciones push ───────────────────────────────────────────────────────
# Protege /api/push/cron. Pon cualquier texto largo y aleatorio y úsalo también en el programador (cron-job.org o GitHub Actions).
CRON_SECRET=
# Opcionales: si no las pones, la app genera y guarda sus propias claves VAPID en la base de datos.
# Para generarlas a mano: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que se envía al servicio de push (mailto: o https:). Por defecto, la URL de tu app en Vercel.
VAPID_SUBJECT=
